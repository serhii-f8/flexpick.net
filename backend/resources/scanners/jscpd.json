{
  "minLines": 10,
  "minTokens": 70,
  "ignore": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/.next/**",
    "**/.git/**",
    "**/storage/**",
    "**/coverage/**",
    "**/storybook-static/**",
    "**/__generated__/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.bundle.js",
    "**/*.map"
  ],
  "absolute": false,
  "gitignore": false
}
