  /* ===== Keyframes ===== */
  @keyframes fpGhostA {
    0% {
      transform: translate(16px, 12px) rotate(0.5deg);
      opacity: 0.35;
    }
    70% {
      opacity: 0.15;
    }
    100% {
      transform: none;
      opacity: 0;
    }
  }
  @keyframes fpGhostB {
    0% {
      transform: translate(-14px, -9px) rotate(-0.4deg);
      opacity: 0.28;
    }
    70% {
      opacity: 0.12;
    }
    100% {
      transform: none;
      opacity: 0;
    }
  }
  @keyframes fpMergeA {
    0% {
      transform: translate(-130px, -85px) rotate(-5deg);
      opacity: 0;
    }
    8%,
    22% {
      transform: translate(-130px, -85px) rotate(-5deg);
      opacity: 1;
    }
    52% {
      transform: none;
      opacity: 0.9;
    }
    64%,
    90% {
      transform: none;
      opacity: 0;
