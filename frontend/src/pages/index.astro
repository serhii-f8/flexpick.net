---
import Layout from '~/layouts/Layout.astro';
import ContactModal from '~/components/widgets/ContactModal.astro';
import { PRODUCT_APP } from 'flexpick:config';
import pricing from '~/data/pricing.json';

const automatedTier = pricing.tiers['audit-automated'];
const starterPlan = pricing.subscriptions['audit-starter'];
const enterprisePlan = pricing.subscriptions['audit-enterprise'];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'FlexPick',
      url: 'https://flexpick.net',
      email: 'hello@flexpick.net',
      description:
        'We rescue AI-built codebases — audits, stabilization, and engineering practices for vibecoded products.',
    },
    { '@type': 'WebSite', name: 'FlexPick', url: 'https://flexpick.net' },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Will you rewrite everything from scratch?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No — full rewrites are slow, expensive, and risky. We keep what works, refactor what is fragile, and rebuild only the parts that are genuinely beyond saving. Your product keeps running the whole time.',
          },
        },
        {
          '@type': 'Question',
          name: 'My product works fine. Why should I care?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'It works today. The pattern we see: features that took days start taking weeks, every change breaks something unrelated, and the whole product depends on one person who gets the code. Fixing that early is far cheaper than fixing it during a crisis.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are you against AI-assisted development?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The opposite — we use AI coding tools every day. They are genuinely great, but on a codebase without structure they duplicate code, miss context, and compound the mess. We fix the foundation and set up guardrails so AI makes your team faster, not more fragile.',
          },
        },
        {
          '@type': 'Question',
          name: 'What do you need from me to start?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Read access to your repository and about 30 minutes of your time to walk us through the product. That is enough for the free audit. We are happy to sign an NDA first.',
          },
        },
        {
          '@type': 'Question',
          name: 'What if the audit finds nothing serious?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Then we tell you exactly that, and you walk away with a free health report confirming your codebase is in good shape. We only take on projects where we are confident we can make a real difference.',
          },
        },
        {
          '@type': 'Question',
          name: 'What happens after the rescue?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Your team continues building — now on a stable foundation, with docs, tests, and AI guardrails in place. If you want us to stay involved for features, reviews, or support, we offer ongoing partnership. If not, everything is set up for you to run without us.',
          },
        },
      ],
    },
  ],
};

const metadata = {
  title: 'FlexPick — We Rescue AI-Built Codebases',
  ignoreTitleTemplate: true,
};

// Risk-map cells + hotspots are rendered statically and hydrated to t=0 by the
// report script on load. Cells carry only an index; the script computes styles.
const cells = Array.from({ length: 48 }, (_, i) => i);
const hotspots = [
  { label: 'PaymentService — 2,400 lines, zero tests', sev: 'critical' },
  { label: 'Auth logic copy-pasted across 6 screens', sev: 'critical' },
  { label: '9 near-identical API client wrappers', sev: 'high' },
  { label: 'No CI — deploys run from a laptop', sev: 'high' },
];
---

<Layout metadata={metadata}>
  <div class="fp-landing">
    <!-- Page-wide engineering grid -->
    <div
      aria-hidden="true"
      style="position: fixed; inset: 0; z-index: 0; pointer-events: none; background-image: linear-gradient(rgba(212,168,83,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(212,168,83,0.035) 1px, transparent 1px); background-size: 72px 72px;"
    >
    </div>
    <div
      aria-hidden="true"
      style="position: fixed; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(ellipse at center, transparent 40%, rgba(11,10,9,0.9) 88%);"
    >
    </div>

    <!-- ===== Stability rail ===== -->
    <div
      id="fp-rail"
      aria-hidden="true"
      style="position: fixed; left: 28px; top: 50%; transform: translateY(-50%); z-index: 60; display: none; flex-direction: column; align-items: center; gap: 14px;"
    >
      <span
        id="fp-rail-label"
        class="fp-mono"
        style="font-size: 10px; letter-spacing: 0.14em; color: rgba(226,105,74,0.9); writing-mode: vertical-rl; transform: rotate(180deg);"
        >SYSTEM: FRAGILE</span
      >
      <div
        style="position: relative; width: 2px; height: 180px; background: rgba(255,255,255,0.08); border-radius: 2px; overflow: hidden;"
      >
        <div
          id="fp-rail-fill"
          style="position: absolute; left: 0; bottom: 0; width: 100%; height: 0%; background: rgba(226,105,74,0.9); transition: height 0.15s linear;"
        >
        </div>
      </div>
      <span id="fp-rail-pct" class="fp-mono" style="font-size: 10px; color: rgba(232,230,222,0.55);">0%</span>
    </div>

    <!-- ===== Nav ===== -->
    <nav
      style="position: sticky; top: 0; z-index: 50; background: rgba(11,10,9,0.72); backdrop-filter: blur(14px); border-bottom: 1px solid rgba(255,255,255,0.06);"
    >
      <div
        style="max-width: 1140px; margin: 0 auto; padding: 0 32px; height: 68px; display: flex; align-items: center; justify-content: space-between;"
      >
        <a href="#top" class="fp-wordmark">Flex<span style="color: #d4a853;">Pick</span></a>
        <div style="display: flex; align-items: center; gap: 32px;">
          <a href="#services" class="fp-navlink" data-nav="services">Services</a>
          <a href="#process" class="fp-navlink" data-nav="process">Process</a>
          <a href="#report" class="fp-navlink" data-nav="report">The audit</a>
          <a href="#faq" class="fp-navlink" data-nav="faq">FAQ</a>
          <a href={`${PRODUCT_APP.url}/login`} class="fp-navlink" rel="nofollow" data-auth-entry>Log in</a>
          <button type="button" class="fp-btn" data-audit-open style="font-size: 14px; padding: 10px 20px;"
            >Get a free audit</button
          >
        </div>
      </div>
    </nav>

    <!-- ===== Hero ===== -->
    <section id="top" style="position: relative; padding: 96px 32px 64px;">
      <div
        data-r="hero-grid"
        style="max-width: 1140px; margin: 0 auto; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 64px; align-items: center;"
      >
        <div>
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 28px;">
            <div style="width: 40px; height: 2px; background: #d4a853;"></div>
            <span class="fp-mono" style="font-size: 12px; letter-spacing: 0.12em; color: rgba(232,230,222,0.5);"
              >WE RESCUE AI-BUILT CODEBASES</span
            >
          </div>
          <div style="position: relative;">
            <h1
              aria-hidden="true"
              class="fp-h1"
              style="position: absolute; inset: 0; margin: 0; color: #d4a853; animation: fpGhostA 1.6s cubic-bezier(0.2,0.7,0.2,1) 0.3s both; pointer-events: none;"
            >
              Your AI-built product works. Let's keep it that way.
            </h1>
            <h1
              aria-hidden="true"
              class="fp-h1"
              style="position: absolute; inset: 0; margin: 0; color: #e8e6de; animation: fpGhostB 1.6s cubic-bezier(0.2,0.7,0.2,1) 0.45s both; pointer-events: none;"
            >
              Your AI-built product works. Let's keep it that way.
            </h1>
            <h1 class="fp-h1" style="position: relative; margin: 0; color: #f5f5f0;">
              Your AI-built product <span style="color: #d4a853;">works</span>. Let's keep it that way.
            </h1>
          </div>
          <p
            style="font-size: 19px; line-height: 1.65; color: rgba(232,230,222,0.6); max-width: 520px; margin: 28px 0 40px;"
          >
            Vibe coding got you to market fast — that was the right call. But when every new feature breaks two old
            ones, it's time for engineering. We turn AI-built codebases into stable, scalable products your team can
            keep building on.
          </p>
          <div style="display: flex; gap: 16px; flex-wrap: wrap;">
            <button type="button" class="fp-btn" data-audit-open style="font-size: 16px; padding: 14px 28px;"
              >Get a free audit →</button
            >
            <a
              class="fp-ghost"
              href={`${PRODUCT_APP.url}/reports/sample`}
              target="_blank"
              rel="noopener"
              style="font-size: 14px; align-self: center;"
            >
              See a sample audit →
            </a>
            <a href="#services" class="fp-ghost" style="font-size: 16px; padding: 14px 28px;">What we do</a>
          </div>
        </div>

        <!-- De-duplication visual -->
        <div
          id="fp-hero-visual"
          aria-hidden="true"
          data-r="hero-visual"
          style="position: relative; height: 400px; display: flex; align-items: center; justify-content: center; transition: transform 0.25s ease-out; transform-style: preserve-3d;"
        >
          <div
            style="position: absolute; width: 260px; padding: 16px; border: 1px dashed rgba(226,105,74,0.4); border-radius: 8px; background: #12100d; animation: fpMergeA 7s cubic-bezier(0.3,0,0.2,1) 0.6s infinite both;"
          >
            <p class="fp-mono" style="margin: 0 0 10px; font-size: 11px; color: rgba(226,105,74,0.8);">
              PaymentService.ts — copy 2
            </p>
            <div
              style="height: 5px; width: 78%; background: rgba(232,230,222,0.1); border-radius: 3px; margin-bottom: 7px;"
            >
            </div>
            <div
              style="height: 5px; width: 62%; background: rgba(232,230,222,0.1); border-radius: 3px; margin-bottom: 7px;"
            >
            </div>
            <div style="height: 5px; width: 70%; background: rgba(232,230,222,0.1); border-radius: 3px;"></div>
          </div>
          <div
            style="position: absolute; width: 260px; padding: 16px; border: 1px dashed rgba(226,105,74,0.4); border-radius: 8px; background: #12100d; animation: fpMergeB 7s cubic-bezier(0.3,0,0.2,1) 0.6s infinite both;"
          >
            <p class="fp-mono" style="margin: 0 0 10px; font-size: 11px; color: rgba(226,105,74,0.8);">
              PaymentService_v2.ts — copy 3
            </p>
            <div
              style="height: 5px; width: 70%; background: rgba(232,230,222,0.1); border-radius: 3px; margin-bottom: 7px;"
            >
            </div>
            <div
              style="height: 5px; width: 80%; background: rgba(232,230,222,0.1); border-radius: 3px; margin-bottom: 7px;"
            >
            </div>
            <div style="height: 5px; width: 58%; background: rgba(232,230,222,0.1); border-radius: 3px;"></div>
          </div>
          <div
            style="position: absolute; width: 260px; padding: 16px; border: 1px dashed rgba(226,105,74,0.4); border-radius: 8px; background: #12100d; animation: fpMergeC 7s cubic-bezier(0.3,0,0.2,1) 0.6s infinite both;"
          >
            <p class="fp-mono" style="margin: 0 0 10px; font-size: 11px; color: rgba(226,105,74,0.8);">
              PaymentServiceNew.ts — copy 4
            </p>
            <div
              style="height: 5px; width: 66%; background: rgba(232,230,222,0.1); border-radius: 3px; margin-bottom: 7px;"
            >
            </div>
            <div
              style="height: 5px; width: 74%; background: rgba(232,230,222,0.1); border-radius: 3px; margin-bottom: 7px;"
            >
            </div>
            <div style="height: 5px; width: 82%; background: rgba(232,230,222,0.1); border-radius: 3px;"></div>
          </div>
          <div
            style="position: relative; width: 280px; padding: 18px; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; background: #14120e; animation: fpBaseGlow 7s cubic-bezier(0.3,0,0.2,1) 0.6s infinite both;"
          >
            <p class="fp-mono" style="margin: 0 0 12px; font-size: 11px; color: #d4a853;">PaymentService.ts</p>
            <div
              style="height: 5px; width: 82%; background: rgba(232,230,222,0.16); border-radius: 3px; margin-bottom: 8px;"
            >
            </div>
            <div
              style="height: 5px; width: 64%; background: rgba(232,230,222,0.16); border-radius: 3px; margin-bottom: 8px;"
            >
            </div>
            <div
              style="height: 5px; width: 74%; background: rgba(232,230,222,0.16); border-radius: 3px; margin-bottom: 8px;"
            >
            </div>
            <div style="height: 5px; width: 48%; background: rgba(212,168,83,0.35); border-radius: 3px;"></div>
          </div>
          <p
            class="fp-mono"
            style="position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%); margin: 0; font-size: 11px; letter-spacing: 0.1em; color: rgba(232,230,222,0.6); white-space: nowrap; animation: fpCaptionIn 0.8s ease 3.6s both;"
          >
            4 copies → 1 source of truth
          </p>
        </div>
      </div>
    </section>

    <!-- ===== Services ===== -->
    <section id="services" style="position: relative; padding: 40px 32px 120px; scroll-margin-top: 80px;">
      <div
        aria-hidden="true"
        class="fp-mono"
        style="position: absolute; top: 20px; left: 28px; font-size: 14px; color: rgba(212,168,83,0.3);"
      >
        +
      </div>
      <div
        aria-hidden="true"
        class="fp-mono"
        style="position: absolute; top: 20px; right: 28px; font-size: 14px; color: rgba(212,168,83,0.3);"
      >
        +
      </div>
      <div style="max-width: 1140px; margin: 0 auto;">
        <div style="text-align: center; margin-bottom: 64px;">
          <p class="fp-mono" style="margin: 0 0 12px; font-size: 12px; letter-spacing: 0.16em; color: #d4a853;">
            SERVICES
          </p>
          <h2 class="fp-h2">From vibecoded to production-grade</h2>
        </div>
        <div data-r="grid3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
          <div
            class="fp-card"
            style="border: 1px solid rgba(255,255,255,0.07); border-radius: 10px; padding: 28px; background: rgba(255,255,255,0.015); animation: fpSettleA 1ms linear both; animation-timeline: view(); animation-range: entry 5% entry 45%;"
          >
            <p class="fp-mono fp-card-tag"><span style="color: #d4a853;">01</span> · audit/</p>
            <h3 class="fp-card-title">Free codebase audit</h3>
            <p class="fp-card-body">
              We dig into your repository and tell you honestly where it stands — the risks, the debt, and what it will
              take to fix. If we can't help, we tell you straight. No charge, no strings.
            </p>
          </div>
          <div
            class="fp-card"
            style="border: 1px solid rgba(255,255,255,0.07); border-radius: 10px; padding: 28px; background: rgba(255,255,255,0.015); animation: fpSettleB 1ms linear both; animation-timeline: view(); animation-range: entry 5% entry 45%;"
          >
            <p class="fp-mono fp-card-tag"><span style="color: #d4a853;">02</span> · stabilize/</p>
            <h3 class="fp-card-title">Stabilization</h3>
            <p class="fp-card-body">
              Tests around the behavior your business depends on, CI that catches regressions before your users do, and
              error monitoring so surprises stop being surprises.
            </p>
          </div>
          <div
            class="fp-card"
            style="border: 1px solid rgba(255,255,255,0.07); border-radius: 10px; padding: 28px; background: rgba(255,255,255,0.015); animation: fpSettleC 1ms linear both; animation-timeline: view(); animation-range: entry 5% entry 45%;"
          >
            <p class="fp-mono fp-card-tag"><span style="color: #d4a853;">03</span> · refactor/</p>
            <h3 class="fp-card-title">Refactoring &amp; simplification</h3>
            <p class="fp-card-body">
              AI agents tend to duplicate instead of reuse. We collapse the copies, untangle the architecture, and
              shrink the codebase — same functionality, far less to maintain.
            </p>
          </div>
          <div
            class="fp-card"
            style="border: 1px solid rgba(255,255,255,0.07); border-radius: 10px; padding: 28px; background: rgba(255,255,255,0.015); animation: fpSettleD 1ms linear both; animation-timeline: view(); animation-range: entry 5% entry 45%;"
          >
            <p class="fp-mono fp-card-tag"><span style="color: #d4a853;">04</span> · practices/</p>
            <h3 class="fp-card-title">Engineering practices</h3>
            <p class="fp-card-body">
              Code review, sane branching, safe deployments, and documentation — the habits that let a team ship
              confidently instead of crossing fingers on every release.
            </p>
          </div>
          <div
            class="fp-card"
            style="border: 1px solid rgba(255,255,255,0.07); border-radius: 10px; padding: 28px; background: rgba(255,255,255,0.015); animation: fpSettleE 1ms linear both; animation-timeline: view(); animation-range: entry 5% entry 45%;"
          >
            <p class="fp-mono fp-card-tag"><span style="color: #d4a853;">05</span> · ai-ready/</p>
            <h3 class="fp-card-title">AI-ready codebase</h3>
            <p class="fp-card-body">
              Clear conventions, guardrails, and project docs that make AI coding tools dramatically more effective — so
              your team keeps its speed without regrowing the mess.
            </p>
          </div>
          <div
            class="fp-card"
            style="border: 1px solid rgba(255,255,255,0.07); border-radius: 10px; padding: 28px; background: rgba(255,255,255,0.015); animation: fpSettleF 1ms linear both; animation-timeline: view(); animation-range: entry 5% entry 45%;"
          >
            <p class="fp-mono fp-card-tag"><span style="color: #d4a853;">06</span> · partner/</p>
            <h3 class="fp-card-title">Ongoing partnership</h3>
            <p class="fp-card-body">
              After the rescue, we can stay on for features, reviews, and support. You keep a senior engineering team a
              message away — only when you need one.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== Process ===== -->
    <section
      id="process"
      style="position: relative; padding: 100px 32px; border-top: 1px solid rgba(255,255,255,0.05); scroll-margin-top: 80px;"
    >
      <div style="max-width: 1140px; margin: 0 auto;">
        <div style="text-align: center; margin-bottom: 72px;">
          <p class="fp-mono" style="margin: 0 0 12px; font-size: 12px; letter-spacing: 0.16em; color: #d4a853;">
            PROCESS
          </p>
          <h2 class="fp-h2">Honest audit. Clear plan. Real fix.</h2>
        </div>
        <div data-r="proc" style="position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px;">
          <div
            aria-hidden="true"
            data-r="procline"
            style="position: absolute; top: 34px; left: 16%; right: 16%; height: 1px; background: linear-gradient(90deg, transparent, rgba(212,168,83,0.35), transparent); transform-origin: left; animation: fpLineDraw 1ms linear both; animation-timeline: view(); animation-range: entry 20% entry 80%;"
          >
          </div>
          <div
            class="fp-proc-col"
            style="animation: fpFadeUp 1ms linear both; animation-timeline: view(); animation-range: entry 5% entry 40%;"
          >
            <p class="fp-num">01</p>
            <h3 class="fp-proc-title">Show us your codebase</h3>
            <p class="fp-proc-body">
              Repository access and a 30-minute call — that's all we need. We audit the code for free and give you an
              honest verdict. If we can't help, we say so.
            </p>
          </div>
          <div
            class="fp-proc-col"
            style="animation: fpFadeUp 1ms linear both; animation-timeline: view(); animation-range: entry 15% entry 50%;"
          >
            <p class="fp-num">02</p>
            <h3 class="fp-proc-title">Get a clear plan</h3>
            <p class="fp-proc-body">
              You receive a health report with risks ranked by impact and a concrete plan of what to fix first — in
              plain language, not engineering jargon.
            </p>
          </div>
          <div
            class="fp-proc-col"
            style="animation: fpFadeUp 1ms linear both; animation-timeline: view(); animation-range: entry 25% entry 60%;"
          >
            <p class="fp-num">03</p>
            <h3 class="fp-proc-title">We stabilize, you keep building</h3>
            <p class="fp-proc-body">
              We fix the foundation without freezing your roadmap, then hand everything back — code, docs, tests, and
              guardrails your team builds on from day one.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== The Audit — interactive Health Report ===== -->
    <section
      id="report"
      style="position: relative; padding: 100px 32px 120px; border-top: 1px solid rgba(255,255,255,0.05); background: rgba(255,255,255,0.012); scroll-margin-top: 80px;"
    >
      <div
        aria-hidden="true"
        class="fp-mono"
        style="position: absolute; top: 20px; left: 28px; font-size: 14px; color: rgba(212,168,83,0.3);"
      >
        +
      </div>
      <div
        aria-hidden="true"
        class="fp-mono"
        style="position: absolute; top: 20px; right: 28px; font-size: 14px; color: rgba(212,168,83,0.3);"
      >
        +
      </div>
      <div style="max-width: 1140px; margin: 0 auto;">
        <div style="text-align: center; margin-bottom: 24px;">
          <p class="fp-mono" style="margin: 0 0 12px; font-size: 12px; letter-spacing: 0.16em; color: #d4a853;">
            THE AUDIT
          </p>
          <h2 class="fp-h2" style="margin-bottom: 16px;">Know exactly where your codebase stands</h2>
          <p
            style="margin: 0 auto; max-width: 620px; font-size: 16px; line-height: 1.65; color: rgba(232,230,222,0.55);"
          >
            Every audit produces a codebase health report. This is what stabilization looks like — drag the timeline, or
            run it.
          </p>
        </div>

        <!-- Controls -->
        <div
          data-r="controls"
          style="max-width: 920px; margin: 0 auto 20px; display: flex; align-items: center; gap: 20px; padding: 0 4px;"
        >
          <button
            type="button"
            id="fp-run"
            class="fp-btn fp-mono"
            style="flex-shrink: 0; white-space: nowrap; font-size: 12px; font-weight: 500; letter-spacing: 0.06em; padding: 10px 18px;"
            >▸ RUN STABILIZATION</button
          >
          <input
            id="fp-slider"
            type="range"
            min="0"
            max="100"
            value="0"
            style="flex: 1; accent-color: #d4a853; cursor: pointer;"
            aria-label="Stabilization timeline"
          />
          <span
            id="fp-week"
            class="fp-mono"
            style="flex-shrink: 0; font-size: 12px; color: rgba(232,230,222,0.6); min-width: 210px; text-align: right;"
            >Week 0 — audit</span
          >
        </div>

        <!-- Report window -->
        <div
          style="max-width: 920px; margin: 0 auto; border: 1px solid rgba(255,255,255,0.09); border-radius: 12px; background: #100e0b; box-shadow: 0 24px 80px rgba(0,0,0,0.4); overflow: hidden;"
        >
          <div
            style="display: flex; align-items: center; gap: 8px; padding: 12px 18px; border-bottom: 1px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.02);"
          >
            <div style="width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.1);"></div>
            <div style="width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.1);"></div>
