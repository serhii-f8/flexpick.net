<script>
  interface CellData {
    bg: string;
    border: string;
    name: string;
    riskNow: number;
    riskColor: string;
    lines: number;
    copies: number;
    cov: number;
    status: string;
    statusColor: string;
  }

  function initLanding() {
    const landing = document.querySelector('.fp-landing');
    if (!landing || landing.hasAttribute('data-init')) return;
    landing.setAttribute('data-init', '');

    // ---- helpers ----
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
    const frac = (x: number) => x - Math.floor(x);
    const mix = (c1: number[], c2: number[], k: number) => c1.map((v, i) => Math.round(v + (c2[i] - v) * k));
    const rgba = (c: number[], a: number) => `rgba(${c[0]},${c[1]},${c[2]},${a.toFixed(2)})`;
    const RED = [226, 105, 74];
    const AMBER = [201, 138, 59];
    const GOLD = [212, 168, 83];
    const PREFIX = [
      'auth',
      'billing',
      'payments',
      'users',
      'orders',
      'cart',
      'search',
      'notify',
      'email',
      'admin',
      'api',
      'webhook',
      'sync',
      'export',
      'reports',
      'settings',
      'upload',
      'chat',
      'feed',
      'analytics',
      'invoice',
      'session',
      'cache',
      'queue',
    ];
    const SUFFIX = ['Service', 'Controller', 'Client', 'Store', 'Handler', 'Utils'];

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;

    // ---- state ----
    let t = 0;
    let raf = 0;
    let tipIdx: number | null = null;
    let cellData: CellData[] = [];

    const cellEls = Array.from(landing.querySelectorAll<HTMLElement>('#fp-cells .fp-cell'));
    const hotspotRows = Array.from(landing.querySelectorAll<HTMLElement>('#fp-hotspots .fp-row'));
    const hotspotFix = [0.25, 0.45, 0.65, 0.85];

    // ---- report compute ----
    function computeCells(tv: number): CellData[] {
      const out: CellData[] = [];
      for (let i = 0; i < 48; i++) {
        const r = frac(Math.sin((i + 1) * 127.1) * 43758.5453);
        const r2 = frac(Math.sin((i + 1) * 269.5) * 32451.77);
        const s = 0.08 + 0.78 * frac(Math.sin((i + 1) * 311.7) * 12543.21);
        const k = clamp((tv - s) / 0.15, 0, 1);
        const hot = mix(AMBER, RED, r);
        const calm = [54, 50, 41];
        const bg = mix(hot, calm, k);
        const alpha = (0.3 + 0.6 * r) * (1 - k) + 0.85 * k;
        const riskNow = r * (1 - k);
        const copies = Math.round(r2 * 4 * (1 - k));
        const lines = Math.round((280 + r * 2300) * (1 - 0.45 * k));
        const cov = Math.round(Math.min(97, 4 + r2 * 8 + 90 * k));
        let status: string, statusColor: string;
        if (k > 0.85) {
          status = '✓ stabilized · tests passing';
          statusColor = rgba(GOLD, 0.9);
        } else if (riskNow > 0.66) {
          status = 'critical — untested hot path';
          statusColor = rgba(RED, 0.9);
        } else if (riskNow > 0.33) {
          status = 'fragile — partial coverage';
          statusColor = rgba(AMBER, 0.9);
        } else {
          status = 'moderate — watch on change';
          statusColor = 'rgba(232,230,222,0.55)';
        }
        out.push({
          bg: rgba(bg, alpha),
          border: '1px solid ' + rgba(GOLD, 0.45 * k),
          name: PREFIX[i % 24] + SUFFIX[Math.floor(r2 * 5.99)] + '.ts',
          riskNow,
          riskColor:
            k > 0.85
              ? rgba(GOLD, 1)
              : riskNow > 0.66
                ? rgba(RED, 1)
                : riskNow > 0.33
                  ? rgba(AMBER, 1)
                  : 'rgba(232,230,222,0.7)',
          lines,
          copies,
          cov,
          status,
          statusColor,
        });
      }
      return out;
    }

    function setText(id: string, text: string) {
      const el = $(id);
      if (el) el.textContent = text;
    }
    function setColor(id: string, color: string) {
      const el = $(id);
      if (el) el.style.color = color;
    }

    function renderReport() {
      // Stats
      const risk = 7.4 - 5.9 * t;
      const dup = Math.round(38 - 32 * t);
      const cov = Math.round(4 + 79 * t);
      setText('fp-risk', risk.toFixed(1));
      setColor('fp-risk', rgba(mix(RED, GOLD, t), 1));
      setText('fp-risk-cap', t < 0.5 ? 'high — fixable' : t < 0.99 ? 'improving' : 'low — under control');
      setText('fp-dup', String(dup));
      setColor('fp-dup', rgba(mix(RED, GOLD, t), 1));
      setText('fp-cov', String(cov));
      setColor('fp-cov', rgba(mix(AMBER, GOLD, t), 1));
      setText(
        'fp-cov-cap',
        t < 0.3 ? 'critical paths: 0%' : t < 0.99 ? 'critical paths first' : 'critical paths: 100%'
      );

      // Composition
      const dupPct = Math.round(38 - 32 * t);
      const deadPct = Math.round(16 - 10 * t);
      const uniquePct = 100 - dupPct - deadPct;
      const cu = $('fp-comp-unique');
      const cd = $('fp-comp-dup');
      const cde = $('fp-comp-dead');
      if (cu) cu.style.width = uniquePct + '%';
      if (cd) cd.style.width = dupPct + '%';
      if (cde) cde.style.width = deadPct + '%';
      setText('fp-leg-unique', 'unique ' + uniquePct + '%');
      setText('fp-leg-dup', 'duplicated ' + dupPct + '%');
      setText('fp-leg-dead', 'dead code ' + deadPct + '%');

      // Status + week label
      const statusLabel = t < 0.02 ? '● UNSTABLE' : t < 0.99 ? '● STABILIZING' : '● PRODUCTION-GRADE';
      const statusColor = t < 0.02 ? rgba(RED, 0.9) : t < 0.99 ? rgba(AMBER, 0.9) : rgba(GOLD, 1);
      setText('fp-status', statusLabel);
      setColor('fp-status', statusColor);
      let weekLabel: string;
      if (t < 0.02) weekLabel = 'Week 0 — audit';
      else if (t < 0.35) weekLabel = 'Weeks 1–3 — tests + CI';
      else if (t < 0.7) weekLabel = 'Weeks 3–6 — de-duplication';
      else if (t < 0.99) weekLabel = 'Weeks 6–8 — hardening';
      else weekLabel = 'Week 8 — production-grade';
      setText('fp-week', weekLabel);

      // Cells
      cellData = computeCells(t);
      for (let i = 0; i < cellEls.length; i++) {
        const c = cellData[i];
        cellEls[i].style.background = c.bg;
        cellEls[i].style.border = c.border;
      }

      // Hotspots
      hotspotRows.forEach((row, i) => {
        const done = t >= hotspotFix[i];
        const sev = row.dataset.sev || 'high';
        const sevBase = sev === 'critical' ? RED : AMBER;
        const dot = row.querySelector<HTMLElement>('[data-dot]');
        const label = row.querySelector<HTMLElement>('[data-label]');
        const sevLabel = row.querySelector<HTMLElement>('[data-sevlabel]');
        if (dot) dot.style.background = done ? rgba(GOLD, 0.9) : rgba(sevBase, 0.9);
        if (label) {
          label.style.color = done ? 'rgba(232,230,222,0.35)' : 'rgba(232,230,222,0.85)';
          label.style.textDecoration = done ? 'line-through' : 'none';
        }
        if (sevLabel) {
          sevLabel.textContent = done ? 'resolved' : sev;
          sevLabel.style.color = done ? rgba(GOLD, 0.8) : rgba(sevBase, 0.75);
        }
      });

      // Refresh tooltip if a cell is hovered
      if (tipIdx !== null) updateTip(tipIdx);

      // Sync slider
      const slider = $<HTMLInputElement>('fp-slider');
      if (slider && document.activeElement !== slider) slider.value = String(Math.round(t * 100));
    }

    function setT(v: number) {
      t = clamp(v, 0, 1);
      renderReport();
    }

    function runStabilization() {
      cancelAnimationFrame(raf);
      const from = t >= 0.99 ? 0 : t;
      const dur = 2800 * (1 - from) + 300;
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - start) / dur);
        const e = 1 - Math.pow(1 - p, 3);
        setT(from + (1 - from) * e);
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    }

    // ---- tooltip ----
    function updateTip(idx: number) {
      const c = cellData[idx];
      if (!c) return;
      setText('fp-tip-name', c.name);
      setText('fp-tip-risk', c.riskNow.toFixed(2) + ' / 1.0');
      setColor('fp-tip-risk', c.riskColor);
      const bar = $('fp-tip-bar');
      if (bar) {
        bar.style.width = Math.round(c.riskNow * 100) + '%';
        bar.style.background = c.riskColor;
      }
      setText('fp-tip-lines', c.lines.toLocaleString('en-US'));
      setText('fp-tip-dup', c.copies > 0 ? c.copies + ' cop' + (c.copies === 1 ? 'y' : 'ies') : 'none');
      setText('fp-tip-cov', c.cov + '%');
      setText('fp-tip-status', c.status);
      setColor('fp-tip-status', c.statusColor);
    }

    const tip = $('fp-tip');
    cellEls.forEach((cell) => {
      cell.addEventListener('mouseenter', () => {
        const idx = Number(cell.dataset.idx);
        const cont = cell.parentElement as HTMLElement;
        const cr = cell.getBoundingClientRect();
        const pr = cont.getBoundingClientRect();
        const x = clamp(cr.left - pr.left + cr.width / 2, 112, pr.width - 112);
        const y = cr.top - pr.top;
        tipIdx = idx;
        updateTip(idx);
        if (tip) {
          tip.style.left = x + 'px';
          tip.style.top = y + 'px';
          tip.style.display = 'block';
        }
      });
      cell.addEventListener('mouseleave', () => {
        tipIdx = null;
        if (tip) tip.style.display = 'none';
      });
    });

    // ---- controls ----
    $('fp-run')?.addEventListener('click', runStabilization);
    $('fp-slider')?.addEventListener('input', (e) => {
      cancelAnimationFrame(raf);
      setT(Number((e.target as HTMLInputElement).value) / 100);
    });

    // Auto-run when the report scrolls into view
    const reportEl = $('report');
    if (reportEl) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting && t === 0) {
            runStabilization();
            io.disconnect();
          }
        },
        { threshold: 0.4 }
      );
      io.observe(reportEl);
    }

    // ---- scroll: stability rail + scroll-spy ----
    const rail = $('fp-rail');
    const railFill = $('fp-rail-fill');
    const railLabel = $('fp-rail-label');
    const railPct = $('fp-rail-pct');
    const navLinks = Array.from(landing.querySelectorAll<HTMLElement>('.fp-navlink[data-nav]'));
    const spySections = ['services', 'process', 'report', 'faq', 'contact'];

    function onScroll() {
      const d = document.documentElement;
      const max = d.scrollHeight - window.innerHeight;
      const progress = max > 0 ? clamp(window.scrollY / max, 0, 1) : 0;

      // Rail
      if (railFill) railFill.style.height = (progress * 100).toFixed(1) + '%';
      if (railPct) railPct.textContent = Math.round(progress * 100) + '%';
      let rLabel: string;
      if (progress < 0.18) rLabel = 'SYSTEM: FRAGILE';
      else if (progress < 0.45) rLabel = 'SYSTEM: AUDITED';
      else if (progress < 0.78) rLabel = 'SYSTEM: STABILIZING';
      else rLabel = 'PRODUCTION-GRADE';
      const rColor =
        progress < 0.33
          ? rgba(mix(RED, AMBER, progress * 3), 0.9)
          : rgba(mix(AMBER, GOLD, clamp((progress - 0.33) * 2.2, 0, 1)), 0.95);
      if (railLabel) {
        railLabel.textContent = rLabel;
        railLabel.style.color = rColor;
      }
      if (railFill) railFill.style.background = rColor;

      // Scroll-spy
      let active = '';
      for (const id of spySections) {
        const el = document.getElementById(id);
        if (el && el.offsetTop - 160 <= window.scrollY) active = id;
      }
      navLinks.forEach((link) => {
        link.setAttribute('data-active', link.dataset.nav === active ? 'true' : 'false');
      });
    }

    function onResize() {
      if (rail) rail.style.display = window.innerWidth >= 1290 ? 'flex' : 'none';
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);

    // ---- hero cursor tilt ----
    const heroVisual = $('fp-hero-visual');
    if (heroVisual) {
      heroVisual.addEventListener('mousemove', (e) => {
        const r = heroVisual.getBoundingClientRect();
        const hx = ((e.clientX - r.left) / r.width - 0.5) * 2;
        const hy = ((e.clientY - r.top) / r.height - 0.5) * 2;
        heroVisual.style.transform = `perspective(900px) rotateY(${(hx * 6).toFixed(2)}deg) rotateX(${(hy * -6).toFixed(2)}deg)`;
      });
      heroVisual.addEventListener('mouseleave', () => {
        heroVisual.style.transform = 'perspective(900px) rotateY(0deg) rotateX(0deg)';
      });
    }

    // ---- service card spotlight ----
    landing.querySelectorAll<HTMLElement>('.fp-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e as MouseEvent).clientX - r.left;
        const y = (e as MouseEvent).clientY - r.top;
        card.style.background = `radial-gradient(260px circle at ${x}px ${y}px, rgba(212,168,83,0.08), rgba(255,255,255,0.015) 65%)`;
        card.style.borderColor = 'rgba(212,168,83,0.35)';
      });
      card.addEventListener('mouseleave', () => {
        card.style.background = 'rgba(255,255,255,0.015)';
        card.style.borderColor = 'rgba(255,255,255,0.07)';
      });
    });

    // ---- magnetic CTA button ----
    const cta = $('fp-cta');
    const ctaBtn = $('fp-cta-btn');
    if (cta && ctaBtn) {
      cta.addEventListener('mousemove', (e) => {
        const r = cta.getBoundingClientRect();
        const cx = clamp((e.clientX - (r.left + r.width / 2)) / 24, -10, 10);
        const cy = clamp((e.clientY - (r.top + r.height / 2)) / 24, -8, 8);
        ctaBtn.style.transform = `translate(${cx.toFixed(1)}px, ${cy.toFixed(1)}px)`;
      });
      cta.addEventListener('mouseleave', () => {
        ctaBtn.style.transform = 'translate(0px, 0px)';
      });
    }

    // ---- init ----
    onScroll();
    onResize();
    renderReport();
  }

  initLanding();
  document.addEventListener('astro:page-load', initLanding);
</script>

<script>
  import { PRODUCT_APP } from 'flexpick:config';

  async function swapAuthLinks() {
    try {
      const res = await fetch(`${PRODUCT_APP.url}/api/auth/status`, {
        credentials: 'include',
        signal: AbortSignal.timeout(4000),
      });
      if (!res.ok) return;
      const data = await res.json();
      if (!data.authenticated) return;
      document.querySelectorAll('[data-auth-entry]').forEach((el) => {
        el.textContent = 'Dashboard';
        el.setAttribute('href', `${PRODUCT_APP.url}/dashboard`);
      });
    } catch {
      // Leave the default "Log in" links on any failure or timeout.
    }
  }

  swapAuthLinks();
  document.addEventListener('astro:after-swap', swapAuthLinks);
</script>
